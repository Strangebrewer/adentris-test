# Copy to .env for local dev
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=adentris

PORT=3000

# --- Ingest ---
# How far in the future an event's `ts` may be before it's rejected with a 400 (ms).
# There's no limit in the past, because backdated events are valid.
INGEST_MAX_FUTURE_SKEW_MS=300000

# --- Worker / queue ---
# How many events one worker process handles at the same time.
# Each one mostly waits ~5s on the external call, so 25 at once is about 300 events/min per worker.
QUEUE_CONCURRENCY=25
# How long a worker's claim on an event lasts before another worker can take it over (ms).
# Keep it well above the processing time. An overrun is safe, but the work gets done twice.
QUEUE_LEASE_MS=15000
# How long an idle worker waits before trying to claim again when nothing is claimable (ms)
QUEUE_IDLE_POLL_MS=500
# When an event can't commit yet because an earlier event for the same patient isn't done,
# it's retried after this delay (ms). Lower is faster, but causes more repeated claims.
QUEUE_BLOCKED_RETRY_DELAY_MS=250
# How many failed attempts an event gets before it's marked `failed` and no longer retried.
# An error counts, and so does a claim whose lease ran out (the worker crashed or took too long).
# Waiting on an earlier event doesn't count.
QUEUE_MAX_ATTEMPTS=5
# The wait before retrying a failed attempt doubles each time, starting from this (ms)
QUEUE_RETRY_BACKOFF_BASE_MS=1000

# --- Processing ---
# Duration of the simulated external call (ms)
PROCESSING_SIMULATED_CALL_MS=5000
# The external call is abandoned after this long (ms). Must be less than QUEUE_LEASE_MS,
# so the call gives up before another worker can take the event over.
PROCESSING_CALL_TIMEOUT_MS=10000

# --- Snapshots ---
# Save a snapshot of a patient's state every N events committed in order.
# Snapshots limit how much history has to be replayed when an event arrives late.
SNAPSHOT_INTERVAL_EVENTS=20
